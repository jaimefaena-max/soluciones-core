# ─────────────────────────────────────────────────────────────────────────────
# ssi-business-init — plantilla de variables de entorno
#
# Componente reutilizable del Vault de la agencia: el aprovisionamiento de un
# negocio (inquilino) nuevo — identidad, autorización, portal y aislamiento.
# Extraído de:
#   zasa-orchestrator/scripts/nuevo-cliente.js   (generador de artefactos)
#   zasa-orchestrator/src/services/tenantAuth.ts (modelo de identidad)
#   zasa-orchestrator/src/data/clientes.ts       (registro de portales)
#   zasa-orchestrator/src/routes/clientesRoutes.ts
#
# CÓMO USARLO
#   1. cp .env.example .env  y completa cada valor. NUNCA comitees el .env.
#   2. Valida antes de desplegar:  node scripts/validar-dependencias.mjs
#   3. Los tokens NO se inventan a mano: usa el generador
#      (node scripts/nuevo-cliente.js <tenantId>) o `openssl rand -hex 32`.
#
# Todos los valores de aquí son FALSOS. Son plantilla, no secretos.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1. IDENTIDAD — quién es quién
# ═════════════════════════════════════════════════════════════════════════════
#
# Toda petición a una ruta con inquilino resuelve a UNA identidad:
#   staff        → el operador (Cockpit), con el token maestro
#   tenant:<id>  → un cliente concreto, con alcance exactamente su propio id
#   ninguna      → 401
#
# 🔴 SIN NINGUNA FUENTE DE IDENTIDAD DE INQUILINO CONFIGURADA, todo el tráfico
# llega como `staff` y el orquestador NO puede distinguir clientes. La
# autorización del código es correcta, pero el agujero queda abierto en el borde.

# Token maestro del operador. El servidor ABORTA el arranque si falta
# (fail-closed). Mínimo 16 caracteres — en la práctica usa 64 hex.
API_SECRET_TOKEN=cambia-me-token-staff-min-16-caracteres

# Fuente FUERTE de identidad de inquilino: un token propio por cliente.
# Formato "id:token,id:token". El id es kebab-case (^[a-z0-9][a-z0-9-]*$) y es
# el MISMO identificador en la URL /portal/<id>, en el htpasswd del VPS y en el
# directorio private/clientes/<id>/. Cada token, mínimo 32 caracteres.
# Un id inválido o un token corto hacen ABORTAR el arranque del orquestador.
#
# ⚠️ AL AÑADIR UN CLIENTE SE CONCATENA, NUNCA SE REEMPLAZA: pisar el valor deja
# a los inquilinos anteriores sin token y sus portales devuelven 401.
TENANT_TOKENS="cliente-ejemplo:cambia-me-token-de-64-hex-por-inquilino"

# Fuente DÉBIL: identidad afirmada por el proxy vía cabecera X-Tenant-Id.
# Solo se acepta si esto es "true" Y la petición ya presenta el token maestro
# (es decir: solo quien demostró ser el proxy de confianza puede afirmar «esta
# petición viene del cliente X»). Pensado para un nginx que ya separa clientes
# por Basic Auth. Si el borde no lo garantiza, déjalo en false.
TRUST_PROXY_IDENTITY=false

# ¿Puede el token maestro entrar a los portales de los inquilinos?
# "false" = aislamiento estricto: ni siquiera staff cruza entre clientes.
STAFF_CROSS_TENANT=false


# ═════════════════════════════════════════════════════════════════════════════
# 2. PRUEBA DE BORDE — que nadie salte el proxy
# ═════════════════════════════════════════════════════════════════════════════

# Secreto que nginx inyecta como cabecera X-Edge-Proof en todo lo que reenvía.
# Una petición directa al origen público no la trae y no supera la prueba.
#
# ⚠️ FALLO ABIERTO ACOTADO: vacía = prueba DESACTIVADA (se acepta el token venga
# o no de nginx). Es deliberado para poder desplegar el código antes que el
# valor, pero en producción no debe quedarse así. El arranque lo advierte por log.
# Genera: openssl rand -hex 32
EDGE_SECRET=


# ═════════════════════════════════════════════════════════════════════════════
# 3. RBAC — quién puede gestionar
# ═════════════════════════════════════════════════════════════════════════════

# Rol que recibe el token maestro en las rutas de gestión: admin|manager|viewer.
# Defecto `manager`: el token del Cockpit NO escala a gestión por sí solo,
# porque /api/admin exige rol admin.
RBAC_STAFF_ROL=manager

# Tokens Bearer adicionales que sí resuelven a admin, separados por coma.
# Permite emitir credenciales de gestión sin reutilizar el token maestro.
# Vacío + RBAC_BOOTSTRAP_ADMIN_PASSWORD vacío → gestión CERRADA (fail-closed).
RBAC_ADMIN_TOKENS=""

# Contraseña del usuario admin inicial, usada SOLO en el primer arranque
# (si la tabla de usuarios está vacía). Mínimo 8 caracteres. Después, rótala
# y retira la variable.
RBAC_BOOTSTRAP_ADMIN_PASSWORD=""

# SQLite de RBAC (usuarios, roles por inquilino, auditoría).
# En producción SIEMPRE a un volumen persistente o ruta durable.
RBAC_DB_PATH=/ruta/persistente/rbac.db


# ═════════════════════════════════════════════════════════════════════════════
# 4. SESIÓN DEL CLIENTE EN SU PORTAL
# ═════════════════════════════════════════════════════════════════════════════

# Secreto HMAC que firma los tokens de acceso del portal. Mínimo 32 caracteres.
# Vacío → la capa queda DESHABILITADA y /api/vip responde 401/503 (fail-closed,
# nunca abierto). Rotarlo revoca de golpe todo lo emitido antes.
CLIENTE_AUTH_SIGNING_SECRET=

# Vida del token de acceso firmado (ms). Defecto 15 min.
CLIENTE_TOKEN_TTL_MS=900000
# Inactividad tolerada antes de caducar la sesión (ms). Defecto 60 min.
CLIENTE_SESION_INACTIVIDAD_MS=3600000
# Vida absoluta de la sesión desde su creación (ms). Defecto 12 h.
CLIENTE_SESION_ABSOLUTA_MS=43200000

# URL que se envía al cliente para entrar a su portal.
URL_ACCESO_CLIENTES=https://solucionesconia.cl/acceso/


# ═════════════════════════════════════════════════════════════════════════════
# 5. PERSISTENCIA
# ═════════════════════════════════════════════════════════════════════════════

# Cadena de conexión de Postgres.
# 🔴 DEGRADACIÓN SILENCIOSA: si NO empieza por postgres:// o postgresql://, el
# código cae a SQLite avisando solo por log. En un despliegue nuevo eso significa
# que los datos del cliente acaban en un fichero efímero sin que nadie se entere.
DATABASE_URL=

# CA en PEM del certificado de Postgres. La verificación TLS es SIEMPRE estricta
# y no tiene escotilla: contra un certificado autofirmado la conexión falla con
# DEPTH_ZERO_SELF_SIGNED_CERT y los barridos periódicos no llegan a correr.
# Multilínea: entre comillas dobles.
DATABASE_CA_CERT=

# Almacén de sesiones: memoria | sql.
# `sql` es además la vía de ARRANQUE que crea el esquema (usuarios, tenant_roles,
# audit_log, cliente_sesiones). Con `memoria` el DDL solo se ejecuta de rebote.
SESSION_STORE=sql

# Bitácora de agentes y transcripciones (inerte si DATABASE_URL es Postgres).
AGENTES_DB_PATH=

# Retención de la bitácora (Ley 19.628).
AGENTES_RETENCION_DIAS=90
