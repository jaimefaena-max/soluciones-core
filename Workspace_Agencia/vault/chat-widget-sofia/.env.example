# ─────────────────────────────────────────────────────────────────────────────
# chat-widget-sofia — plantilla de variables de entorno
#
# Componente reutilizable del Vault de la agencia. Extraído de:
#   backend  → zasa-orchestrator  (src/controllers/salesAgentController.ts,
#              src/routes/salesAgentRoutes.ts, src/data/salesAgentTenants.ts)
#   frontend → admin_solucionesconia (src/vendedor-ia.tsx, vite.widget.config.ts)
#
# CÓMO USARLO
#   1. cp .env.example .env  y completa cada valor. NUNCA comitees el .env.
#   2. Las variables VITE_* se inlinean en el bundle EN TIEMPO DE BUILD.
#      Cambiarlas exige RECOMPILAR el widget: no basta con reiniciar el backend.
#   3. Valida antes de desplegar:  node scripts/validar-dependencias.mjs
#
# Todos los valores de aquí son FALSOS. Son plantilla, no secretos.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1. EL SECRETO COMPARTIDO — las tres copias que deben coincidir
# ═════════════════════════════════════════════════════════════════════════════
#
# El mismo valor vive en TRES sitios. Si uno se desincroniza, /chat y /book
# responden 403 y el widget queda mudo sin ningún error visible en el navegador
# más allá del 403. Es el fallo nº 1 de este componente en producción.
#
#   (a) Backend      → SALES_AGENT_WIDGET_TOKEN        (env del orquestador)
#   (b) Bundle       → VITE_SALES_AGENT_WIDGET_TOKEN   (env de BUILD del widget)
#   (c) Borde nginx  → proxy_set_header X-Widget-Token (si nginx lo inyecta)
#
# El orden de rotación importa: primero (a) acepta el valor nuevo, luego se
# recompila y sube (b), y solo al final se retira el viejo. Al revés se corta
# el servicio.

# (a) Lo que el orquestador espera en la cabecera x-widget-token.
#
# 🔴 FAIL-CLOSED, no opt-in. Si esta variable está vacía, guardarAccesoPublicoEstricto
# responde 403 a TODO /chat y /book y lo registra como incidente de configuración.
# (La plantilla del orquestador dice lo contrario — «si está vacía la guarda se
# salta entera». Está desfasada: el código verificado falla cerrado.)
SALES_AGENT_WIDGET_TOKEN=cambia-me-token-widget-min-32-hex

# (b) El mismo valor, para el build del bundle. vite.widget.config.ts ABORTA el
# build si falta, para que nunca se genere un bundle mudo.
VITE_SALES_AGENT_WIDGET_TOKEN=cambia-me-token-widget-min-32-hex


# ═════════════════════════════════════════════════════════════════════════════
# 2. MOTORES DE LENGUAJE
# ═════════════════════════════════════════════════════════════════════════════

# Enrutador semántico de intención (deepseek-chat).
# Ausente → el endpoint DEGRADA a un clasificador heurístico local. No revienta,
# pero la calidad del enrutado cae: es una degradación silenciosa, vigílala.
DEEPSEEK_API_KEY=sk-falsa-deepseek-cambia-me

# Generación de la respuesta comercial (Claude).
ANTHROPIC_API_KEY=sk-ant-falsa-anthropic-cambia-me

# Rollback explícito al motor Claude. Solo la cadena "true" lo activa.
AGENT_ANTHROPIC_MOTOR=false

# Síntesis de voz (ElevenLabs). OPCIONAL: sin ella el widget funciona en texto.
# Actívala solo si el cliente contrató la respuesta hablada — cada respuesta
# sintetizada se cobra aparte del LLM.
ELEVENLABS_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# 3. AISLAMIENTO ENTRE CLIENTES (CORS + rate limit)
# ═════════════════════════════════════════════════════════════════════════════

# Orígenes que pueden LEER respuestas cross-origin, separados por coma.
# OJO: esto es la lista GLOBAL del servidor. El aislamiento real por cliente lo
# impone `allowedOrigins` de cada tenant en el registro (ver README, §Contrato).
# Un origen aquí no autoriza a nadie a hablar con el contexto de otro cliente.
CORS_ALLOWED_ORIGINS=https://portal.cliente-ejemplo.cl,https://www.cliente-ejemplo.cl

# Origin "null" (página abierta como file://). En producción: false.
CORS_ALLOW_NULL_ORIGIN=false

# Saltos de proxy en los que confiar para resolver la IP real. De esto depende
# que el rate-limit sea por visitante y no por proxy.
#   "1" → un nginx delante | "10.0.0.0/8" → solo ese CIDR | "false" → sin proxy
# 🔴 NUNCA "true": acepta cualquier X-Forwarded-For y la IP pasa a ser falsificable,
# lo que vacía de sentido el límite de 10 req/min de /chat.
TRUST_PROXY=1


# ═════════════════════════════════════════════════════════════════════════════
# 4. EFECTOS DE LADO DEL CIERRE (agenda, correo, CRM, webhook)
# ═════════════════════════════════════════════════════════════════════════════
# Todo esto lo dispara POST /sales-agent/book. Si el cliente no agenda reuniones
# desde el widget, se puede omitir el bloque entero y /chat sigue funcionando.

# Cuenta de servicio de Google Calendar.
GOOGLE_CLIENT_EMAIL=service-account-falso@proyecto.iam.gserviceaccount.com
# Entre comillas dobles: el PEM lleva saltos de línea reales.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCLAVE_PEM_FALSA_CAMBIA_ME\n-----END PRIVATE KEY-----\n"

# 🔴 NO PONER "primary". Una cuenta de servicio no es una persona y no tiene
# calendario propio: la API responde 200 y la reunión no existe para nadie.
# Comparte un calendario real con el correo de la cuenta de servicio y pega aquí
# su "ID de calendario".
GOOGLE_CALENDAR_ID=cambia-me@group.calendar.google.com

# Correo de confirmación al prospecto (Resend). NO es opcional en la práctica:
# el evento de Google no lleva `attendees`, así que este correo es la ÚNICA
# constancia que recibe la persona de que su reunión existe.
RESEND_API_KEY=re_clave_falsa_cambia_me
RESEND_FROM="Asistente <asistente@cliente-ejemplo.cl>"

# Aviso al equipo por cada lead nuevo (Slack/Discord/Make). Ausente → solo log.
SALES_WEBHOOK_URL=https://hook.falso.ejemplo/nuevo-lead

# Persistencia de prospectos. En producción SIEMPRE a una ruta durable o volumen.
CRM_DB_PATH=/ruta/persistente/crm.db


# ═════════════════════════════════════════════════════════════════════════════
# 5. TELEMETRÍA DEL EMBUDO (opcional)
# ═════════════════════════════════════════════════════════════════════════════
# Se inlinean en el bundle: recompilar tras cambiarlas.
VITE_LINKEDIN_PARTNER_ID=
VITE_LINKEDIN_CONVERSION_ID=

# Días que se conservan las TRANSCRIPCIONES literales de conversaciones.
# 🔴 Ley 19.628: si el barrido deja de correr, esta tabla se convierte en un
# archivo indefinido de datos personales. No subir sin una razón escrita.
MENSAJES_RETENCION_DIAS=90
